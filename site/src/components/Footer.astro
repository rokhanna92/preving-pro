---
import services from '../data/services.json';

interface Props {
  /** Prefix for the service anchors: '/usluge' from elsewhere, '' when already on that page. */
  serviceHref?: string;
  /** Fifth link in the USLUGE column, or null to leave the column at four. */
  lastLink?: { href: string; label: string } | null;
}

const {
  serviceHref = '/usluge',
  lastLink = { href: '#paketi', label: 'Pro paket · ključ u ruke' },
} = Astro.props;

const updated = '21.08.2026.';
---

<footer style="position:relative; z-index:2; background:#040404; color:#F2F1EC; border-top:1px solid rgba(255,255,255,.1); padding:64px 32px 0">
  <div style="max-width:1360px; margin:0 auto">
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:40px; padding-bottom:48px">
      <div>
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px">
          <img src="/logo-mark.png" alt="" width="37" height="24" style="display:block; width:37px; height:24px; flex:none" />
          <span style="font:700 15px 'IBM Plex Sans',system-ui,sans-serif; color:#fff">PREVING<span style="color:#FECB0F">PRO</span></span>
        </div>
        <p style="margin:0; font:400 13px/1.7 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.5)">Preving Pro agencija za preventivni inženjering i tehničko savetovanje, Boris Sabo PR, Novi Sad<br />Temerinski put 51, Klisa, 21000 Novi Sad<br />Šifra delatnosti 7112</p>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">USLUGE</p>
        <div style="display:grid; gap:10px; font:400 14px 'IBM Plex Sans',system-ui,sans-serif">
          {services.map((s) => (
            <a href={`${serviceHref}#${s.id}`} class="ftr-a" style="color:rgba(255,255,255,.75)">{s.title}</a>
          ))}
          {lastLink && <a href={lastLink.href} class="ftr-a" style="color:rgba(255,255,255,.75)">{lastLink.label}</a>}
        </div>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">LICENCE</p>
        <p style="margin:0; font:400 13px/1.8 'IBM Plex Sans',system-ui,sans-serif; color:rgba(255,255,255,.5)">Savetnik za BZR<br />Koordinator u fazi izrade projekta<br />Koordinator u fazi izvođenja radova<br />Referent zaštite od požara<br /><span style="color:rgba(255,255,255,.35)">Inspektorat za rad · MUP RS</span></p>
      </div>
      <div>
        <p style="margin:0 0 14px; font:600 10.5px 'IBM Plex Mono',monospace; letter-spacing:.2em; color:rgba(255,255,255,.4)">KONTAKT</p>
        <div style="display:grid; gap:10px; font:500 13.5px 'IBM Plex Mono',monospace">
          <a href="tel:+381638185587" class="ftr-a" style="color:#FECB0F">063 81 855 87</a>
          <a href="mailto:boris.sabo@previngpro.rs" class="ftr-a" style="color:rgba(255,255,255,.75)">boris.sabo@previngpro.rs</a>
          <a href="mailto:mira.lainovic@previngpro.rs" class="ftr-a" style="color:rgba(255,255,255,.75)">mira.lainovic@previngpro.rs</a>
          <span style="color:rgba(255,255,255,.45)">pon–pet 08–16 · linija 24/7</span>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid rgba(255,255,255,.1); padding:20px 0 24px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:14px; font:400 12px 'IBM Plex Mono',monospace; color:rgba(255,255,255,.35)">
      <span>© 2026 Preving Pro · Politika privatnosti · Uslovi korišćenja</span>
      <span>ЋИР / LAT · Ažurirano: {updated}</span>
    </div>
  </div>
</footer>

<button type="button" class="to-top" id="to-top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path>
  </svg>
  <span class="to-top-sr">Nazad na vrh</span>
</button>

<style>
  /* Own hover rules, so the footer behaves the same on dark and light pages.
     !important is required: the base colors sit in inline style attributes,
     which otherwise win over any stylesheet rule. */
  .ftr-a:hover { color: #FECB0F !important; text-decoration: none !important; }

  /* ---- Povratak na vrh ---- */
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    /* Ispod menija kupe (59) i trake (60), pa ga otvoren meni prekrije. */
    z-index: 40;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: #FECB0F;
    color: #070707;
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity .3s ease, transform .3s ease, background .2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  /* Traka upozorenja na gornjoj ivici, isti motiv kao znak u zaglavlju. */
  .to-top::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5px;
    background: repeating-linear-gradient(135deg, #070707 0 4px, transparent 4px 8px);
  }
  .to-top.on { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { background: #fff; }
  .to-top:focus-visible { outline: 2px solid #FECB0F; outline-offset: 3px; }
  /* Naziv je pravi tekst, ne aria-label, da ga prebacivanje pisma prevede. */
  .to-top-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .to-top { right: 14px; bottom: 14px; width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top { transition: none; }
  }

  /* Veće mete za prst na telefonu. */
  @media (max-width: 900px) {
    .ftr-a { display: inline-block; padding: 9px 0; }
  }
</style>

<script>
  const toTop = document.getElementById('to-top');
  if (toTop) {
    let raf = 0;
    const sync = () => {
      raf = 0;
      toTop.classList.toggle('on', window.scrollY > 600);
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    sync();
    toTop.addEventListener('click', () => {
      // html ima scroll-behavior:smooth, pa se ovde izricito trazi skok
      // kada korisnik trazi manje pokreta.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
