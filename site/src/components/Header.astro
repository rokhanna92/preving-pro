---
interface Props {
  /** 'home' is the one-page nav with the script switch, 'inner' is the site-wide nav. */
  variant?: 'home' | 'inner';
  /** href of the nav item to mark as current. */
  active?: string;
  showBanner?: boolean;
  /** Banner tone: yellow on dark pages, dark on the light cenovnik page. */
  banner?: 'yellow' | 'dark';
  /** Overrides the CTA target, e.g. an in-page anchor on the kontakt page. */
  cta?: string;
}

const { variant = 'home', active = '', showBanner = true, banner = 'yellow', cta } = Astro.props;
const inner = variant === 'inner';
const darkBanner = banner === 'dark';

const homeNav = [
  { n: '01', label: 'Usluge', href: '/usluge' },
  { n: '02', label: 'Rokovi', href: '#rokovi' },
  { n: '03', label: 'Paketi', href: '#paketi' },
  { n: '04', label: 'Cenovnik', href: '/cenovnik' },
  { n: '05', label: 'O nama', href: '/o-nama' },
  { n: '06', label: 'FAQ', href: '#faq' },
];

const innerNav = [
  { n: '00', label: 'Početna', href: '/' },
  { n: '01', label: 'Usluge', href: '/usluge' },
  { n: '02', label: 'Cenovnik', href: '/cenovnik' },
  { n: '03', label: 'O nama', href: '/o-nama' },
  { n: '04', label: 'Kontakt', href: '/kontakt' },
];

const nav = inner ? innerNav : homeNav;
const bannerHref = inner ? '/#provera' : '#provera';
const logoHref = inner ? '/' : '#pp-root';
const ctaHref = cta ?? (inner ? '/kontakt' : '#kontakt');
const navStyle = inner
  ? "display:flex; gap:26px; flex-wrap:wrap; justify-content:center; font:500 12.5px 'IBM Plex Mono',monospace"
  : "display:flex; gap:26px; flex-wrap:wrap; justify-content:center; font:500 12.5px 'IBM Plex Mono',monospace; letter-spacing:.02em";
const bannerStyle = darkBanner
  ? 'background:#070707; color:#FECB0F; display:flex; align-items:center; justify-content:center; gap:20px; flex-wrap:wrap; padding:9px 20px; text-align:center'
  : 'background:#FECB0F; color:#070707; display:flex; align-items:center; justify-content:center; gap:20px; flex-wrap:wrap; padding:9px 20px; text-align:center';
const bannerLinkStyle = darkBanner
  ? "font:700 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:rgba(255,255,255,.75); text-decoration:underline; text-underline-offset:3px"
  : "font:700 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em; color:#070707; text-decoration:underline; text-underline-offset:3px";

// 1. januar 2027. u 00:00 po srednjoevropskom vremenu.
const target = Date.parse('2027-01-01T00:00:00+01:00');
const days = Math.max(0, Math.floor((target - Date.now()) / 864e5));
---

{showBanner && (
<div style={bannerStyle}>
  <span style="font:600 11.5px 'IBM Plex Mono',monospace; letter-spacing:.14em">ČETIRI NOVA PRAVILNIKA SE PRIMENJUJU OD 01.01.2027. · JOŠ <span data-cd="days">{days}</span> DANA</span>
  <a href={bannerHref} class="hdr-banner-a" style={bannerLinkStyle}>PROVERITE OBAVEZE →</a>
</div>
)}

<div style="position:sticky; top:0; z-index:60; background:rgba(4,4,4,.92); backdrop-filter:blur(10px); border-bottom:1px solid rgba(254,203,15,.16)">
  <div class="hdr-bar" style="max-width:1360px; margin:0 auto; padding:0 32px; height:64px; display:flex; align-items:center; justify-content:space-between; gap:24px">
    <a href={logoHref} class="hdr-logo" style="display:flex; align-items:center; gap:11px; flex:none; color:#fff">
      <span style="width:28px; height:28px; position:relative; display:block">
        <span style="position:absolute; left:0; top:0; width:28px; height:8px; background:repeating-linear-gradient(135deg,#FECB0F 0 4px,#070707 4px 8px); border:1px solid #FECB0F; box-sizing:border-box"></span>
        <span style="position:absolute; left:0; top:8px; width:8px; height:20px; background:#FECB0F"></span>
        <span style="position:absolute; right:0; top:8px; width:8px; height:20px; background:#FECB0F"></span>
      </span>
      <span style="font:800 16.5px Archivo,sans-serif; color:#fff; letter-spacing:-.01em">PREVING<span style="color:#FECB0F">PRO</span></span>
    </a>
    <nav class="hdr-nav" style={navStyle}>
      {nav.map((item) => (
        <a href={item.href} class="hdr-a" style={item.href === active ? 'color:#FECB0F' : 'color:rgba(255,255,255,.75)'}><span style="color:rgba(254,203,15,.6)">{item.n}</span> {item.label}</a>
      ))}
    </nav>
    <div class="hdr-right" style="display:flex; align-items:center; gap:16px; flex:none">
      {!inner && (
        <span class="hdr-scripts" style="display:flex; align-items:center; gap:5px; font:500 11px 'IBM Plex Mono',monospace">
          <button type="button" data-script-btn="cir" style="all:unset; cursor:pointer; padding:12px 2px; color:rgba(255,255,255,.5)">ЋИР</button>
          <span style="color:rgba(255,255,255,.3)">/</span>
          <button type="button" data-script-btn="lat" style="all:unset; cursor:pointer; padding:12px 2px; color:#FECB0F; text-decoration:underline; text-underline-offset:4px">LAT</button>
        </span>
      )}
      <a href={ctaHref} class="hdr-cta" style="background:#FECB0F; color:#070707; font:700 13px Archivo,sans-serif; padding:11px 18px; flex:none">Zatražite ponudu</a>
      <button type="button" class="cone-btn" id="hdr-cone" aria-expanded="false" aria-controls="hdr-menu" aria-label="Meni">
        <svg class="cone" viewBox="0 0 44 44" aria-hidden="true">
          <defs>
            <linearGradient id="cone-gy" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#7d5f04"></stop>
              <stop offset=".3" stop-color="#d9a90c"></stop>
              <stop offset=".46" stop-color="#FECB0F"></stop>
              <stop offset=".52" stop-color="#ffe27a"></stop>
              <stop offset=".6" stop-color="#FECB0F"></stop>
              <stop offset=".82" stop-color="#c79a09"></stop>
              <stop offset="1" stop-color="#6e5403"></stop>
            </linearGradient>
            <linearGradient id="cone-gw" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#8f8f8f"></stop>
              <stop offset=".32" stop-color="#e8e8e8"></stop>
              <stop offset=".5" stop-color="#ffffff"></stop>
              <stop offset=".68" stop-color="#e0e0e0"></stop>
              <stop offset="1" stop-color="#858585"></stop>
            </linearGradient>
            <linearGradient id="cone-gb" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#e7b70d"></stop>
              <stop offset=".5" stop-color="#c1950a"></stop>
              <stop offset="1" stop-color="#8a6a05"></stop>
            </linearGradient>
          </defs>
          <ellipse class="cone-shadow" cx="22" cy="40.6" rx="15" ry="2" fill="#000" opacity=".35"></ellipse>
          <g class="seg seg3">
            <path d="M11.6 28 H32.4 L35 34 H9 Z" fill="url(#cone-gy)"></path>
            <rect x="6" y="34" width="32" height="5" rx="1.8" fill="url(#cone-gb)"></rect>
          </g>
          <g class="seg seg2">
            <path d="M16.4 17 H27.6 L30.7 24 H13.3 Z" fill="url(#cone-gy)"></path>
            <path d="M13.3 24 H30.7 L32.4 28 H11.6 Z" fill="url(#cone-gw)"></path>
          </g>
          <g class="seg seg1">
            <path d="M22 4 L18.5 12 H25.5 Z" fill="url(#cone-gy)"></path>
            <path d="M18.5 12 H25.5 L27.6 17 H16.4 Z" fill="url(#cone-gw)"></path>
          </g>
        </svg>
      </button>
    </div>
  </div>
</div>

<nav class="cone-menu" id="hdr-menu" aria-label="Glavna navigacija">
  <div class="cone-menu-grid">
    {nav.map((item) => (
      <a href={item.href}><span>{item.n}</span>{item.label}</a>
    ))}
  </div>
  <div class="cone-menu-foot">
    {!inner ? (
      <span style="display:flex; align-items:center; gap:5px; font:500 12px 'IBM Plex Mono',monospace">
        <button type="button" data-script-btn="cir" style="all:unset; cursor:pointer; padding:10px 2px; color:rgba(255,255,255,.5)">ЋИР</button>
        <span style="color:rgba(255,255,255,.3)">/</span>
        <button type="button" data-script-btn="lat" style="all:unset; cursor:pointer; padding:10px 2px; color:#FECB0F; text-decoration:underline; text-underline-offset:4px">LAT</button>
      </span>
    ) : (
      <span>PREVING<b style="color:#FECB0F">PRO</b></span>
    )}
    <a href="tel:+381638185587">063 81 855 87</a>
  </div>
</nav>

<style>
  /* Own hover rules, so the bar behaves the same on dark and light pages.
     !important is required: the base colors sit in inline style attributes,
     which otherwise win over any stylesheet rule. */
  .hdr-a:hover { color: #FECB0F !important; text-decoration: none !important; }
  .hdr-logo:hover { text-decoration: none !important; }
  .hdr-cta:hover { background: #fff !important; color: #070707 !important; text-decoration: none !important; }

  /* ---- kupa: dugme koje zamenjuje navigaciju na tabletu i telefonu ---- */
  .cone-btn {
    all: unset;
    width: 46px;
    height: 46px;
    display: none; /* vidljivo samo ispod 900px */
    place-items: center;
    cursor: pointer;
    flex: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cone-btn:focus-visible { outline: 2px solid #FECB0F; outline-offset: 2px; }
  .cone { width: 38px; height: 38px; display: block; overflow: visible; }

  /* Svaki segment kupe se odmota: pun okret unazad dok se rasteže u ravnu
     traku. Otvoreno stanje izgleda kao sklopljena teleskopska kupa. */
  .seg {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform .62s cubic-bezier(.34, 1.38, .44, 1);
  }
  .seg1 { transition-delay: 0s; }
  .seg2 { transition-delay: .07s; }
  .seg3 { transition-delay: .14s; }
  .cone-btn[aria-expanded="true"] .seg1 { transform: translateY(-1.5px) rotate(-360deg) scaleX(2.5) scaleY(.45); }
  .cone-btn[aria-expanded="true"] .seg2 { transform: rotate(-360deg) scaleX(1.35) scaleY(.5); }
  .cone-btn[aria-expanded="true"] .seg3 { transform: translateY(1.5px) rotate(-360deg) scaleX(.88) scaleY(.55); }

  .cone-shadow {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform .62s ease, opacity .62s ease;
  }
  .cone-btn[aria-expanded="true"] .cone-shadow { transform: scaleX(1.18); opacity: .16; }

  /* ---- meni preko celog ekrana, otvara se kružno iz kupe ---- */
  .cone-menu {
    position: fixed;
    inset: 0;
    z-index: 59; /* ispod trake (60), pa kupa ostaje vidljiva i pritisliva */
    background: rgba(4, 4, 4, .97);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    display: none;
    flex-direction: column;
    justify-content: center;
    padding: 110px 24px 40px;
    box-sizing: border-box;
    clip-path: circle(0% at calc(100% - 39px) 41px);
    transition: clip-path .52s cubic-bezier(.4, 0, .2, 1);
    pointer-events: none;
  }
  .cone-menu.open { clip-path: circle(145% at calc(100% - 39px) 41px); pointer-events: auto; }
  .cone-menu-grid { display: grid; gap: 2px; max-width: 520px; width: 100%; margin: 0 auto; }
  .cone-menu-grid a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 14px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    font: 800 clamp(22px, 6.4vw, 32px)/1.05 Archivo, sans-serif;
    letter-spacing: -.03em;
    color: #fff;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity .4s ease, transform .4s ease;
  }
  .cone-menu.open .cone-menu-grid a { opacity: 1; transform: none; }
  .cone-menu.open .cone-menu-grid a:nth-child(1) { transition-delay: .16s; }
  .cone-menu.open .cone-menu-grid a:nth-child(2) { transition-delay: .21s; }
  .cone-menu.open .cone-menu-grid a:nth-child(3) { transition-delay: .26s; }
  .cone-menu.open .cone-menu-grid a:nth-child(4) { transition-delay: .31s; }
  .cone-menu.open .cone-menu-grid a:nth-child(5) { transition-delay: .36s; }
  .cone-menu.open .cone-menu-grid a:nth-child(6) { transition-delay: .41s; }
  .cone-menu-grid a span { font: 700 12px 'IBM Plex Mono', monospace; color: #FECB0F; flex: none; }
  .cone-menu-foot {
    max-width: 520px;
    width: 100%;
    margin: 26px auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font: 600 12px 'IBM Plex Mono', monospace;
    color: rgba(255, 255, 255, .5);
    opacity: 0;
    transition: opacity .4s ease .44s;
  }
  .cone-menu.open .cone-menu-foot { opacity: 1; }
  .cone-menu-foot a { font: 700 15px 'IBM Plex Mono', monospace; color: #FECB0F; }

  /* Tablet i telefon: navigacija u traci nestaje, kupa je preuzima.
     Desktop iznad 900px ostaje netaknut. */
  @media (max-width: 900px) {
    .hdr-bar {
      height: 56px !important;
      padding: 0 16px !important;
      gap: 12px !important;
    }
    .hdr-nav { display: none !important; }
    .hdr-scripts { display: none !important; } /* prekidač živi u meniju */
    .hdr-right { gap: 8px !important; }
    .cone-btn { display: grid; }
    .cone-menu { display: flex; }
    .hdr-banner-a { display: inline-block; padding: 7px 0; }
  }

  @media (max-width: 460px) {
    .hdr-cta { padding: 11px 12px !important; font-size: 12px !important; }
  }

  /* Najuži telefoni: logo, dugme i kupa moraju stati u 320px. */
  @media (max-width: 360px) {
    .hdr-bar { padding: 0 12px !important; gap: 8px !important; }
    .hdr-logo { gap: 8px !important; }
    .hdr-logo > span:last-child { font-size: 14px !important; }
    .hdr-right { gap: 6px !important; }
    .hdr-cta { padding: 10px 8px !important; font-size: 11px !important; }
    .cone-btn { width: 40px; height: 40px; }
    .cone { width: 34px; height: 34px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .seg, .cone-shadow, .cone-menu, .cone-menu-grid a, .cone-menu-foot { transition: none !important; }
  }
</style>

<script>
  const btn = document.getElementById('hdr-cone');
  const menu = document.getElementById('hdr-menu');

  if (btn && menu) {
    const setOpen = (v: boolean) => {
      btn.setAttribute('aria-expanded', String(v));
      menu.classList.toggle('open', v);
      document.body.style.overflow = v ? 'hidden' : '';
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Ako se prozor raširi iznad 900px dok je meni otvoren, zatvori ga.
    matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
